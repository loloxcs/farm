PORT=3000
JWT_SECRET=troque-este-valor-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=240h

# MongoDB Atlas — TODOS os dados do sistema ficam aqui (obrigatório).
# Atlas → Database → Connect → Drivers → copie a string e troque <password>.
# Nunca coloque a string real neste arquivo de exemplo: só em backend/.env (que o Git ignora).
MONGO_URI=
# Nome do banco dentro do cluster (opcional; padrão: farm)
# MONGO_DB=farm

# Só para a migração única do banco local antigo (npm run db:migrate)
DB_PATH=./database.sqlite
